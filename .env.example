# ECF AR Portal — Environment Variables
# Copy this to .env and fill in the values

# ─── Sage Intacct Credentials ───────────────────────────────────────────────
SAGE_SENDER_ID=eastcoast
SAGE_SENDER_PASSWORD=your_sage_sender_password_here
SAGE_COMPANY_ID=eastcoast
SAGE_USER_ID=OpenClaw
SAGE_USER_PASSWORD=your_sage_user_password_here

# ─── Azure AD / Entra ID (login SSO + Graph API) ────────────────────────────
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_app_registration_client_id_here
AZURE_CLIENT_SECRET=your_azure_app_registration_client_secret_here
REDIRECT_URI=https://ar.eastcoastfacilities.com/auth/callback

# ─── Omnia (headless login for invoice sync) ────────────────────────────────
OMNIA_EMAIL=your_omnia_login_email_here
OMNIA_PASSWORD=your_omnia_login_password_here

# ─── Amazon Payee Central (headless login for PO/invoice status scrape) ─────
PAYEE_EMAIL=your_payee_central_login_email_here
PAYEE_PASSWORD=your_payee_central_login_password_here

# ─── Session Secret (generate a random string) ──────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# ─── App Config ─────────────────────────────────────────────────────────────
PORT=3600
NODE_ENV=production
